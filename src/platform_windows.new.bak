//! Windows PTY implementation using ConPTY (dynamically loaded) and tokio NamedPipes
//!
//! Improvements from portable-pty:
//! - Dynamic ConPTY loading for graceful degradation on older Windows
//! - Proper Windows command line quoting (ArgvQuote algorithm)
//! - ChildKiller trait for deadlock-free kill/wait

use crate::errors::{PtyErrorKind, PtyResult};
use crate::platform::{ChildBackend, ChildKiller, ProcessExit, PtyBackend};
use crate::winsize::Winsize;
use std::ffi::OsStr;
use std::os::windows::ffi::OsStrExt;

use std::sync::Arc;
use std::thread;
use std::time::Duration;

use windows::core::PWSTR;
use windows::Win32::Foundation::{CloseHandle, HANDLE, INVALID_HANDLE_VALUE};
use windows::Win32::Storage::FileSystem::{ReadFile, WriteFile};
use windows::Win32::System::Pipes::CreatePipe;
use windows::Win32::Security::SECURITY_ATTRIBUTES;
use windows::Win32::System::Console::{COORD, PSEUDOCONSOLE_INHERIT_CURSOR};

use windows::Win32::System::Threading::{
    CreateProcessW, GetExitCodeProcess, GetProcessId, TerminateProcess,
    CREATE_UNICODE_ENVIRONMENT, EXTENDED_STARTUPINFO_PRESENT, PROCESS_INFORMATION,
    STARTUPINFOEXW, STARTUPINFOW_FLAGS, LPPROC_THREAD_ATTRIBUTE_LIST,
    InitializeProcThreadAttributeList, UpdateProcThreadAttribute, DeleteProcThreadAttributeList,
};
use windows::Win32::UI::WindowsAndMessaging::SW_HIDE;

// ConPTY function pointers (loaded dynamically)
type PfnCreatePseudoConsole = extern "system" fn(
    COORD,
    *mut std::ffi::c_void,
    *mut std::ffi::c_void,
    u32,
    *mut HANDLE,
) -> i32;

type PfnResizePseudoConsole = extern "system" fn(HANDLE, COORD) -> i32;
type PfnClosePseudoConsole = extern "system" fn(HANDLE) -> i32;

static mut CREATE_PSEUDO_CONSOLE: Option<PfnCreatePseudoConsole> = None;
static mut RESIZE_PSEUDO_CONSOLE: Option<PfnResizePseudoConsole> = None;
static mut CLOSE_PSEUDO_CONSOLE: Option<PfnClosePseudoConsole> = None;

unsafe fn create_pseudoconsole(
    size: COORD,
    h_input: *mut std::ffi::c_void,
    h_output: *mut std::ffi::c_void,
    flags: u32,
    ph_pc: *mut HANDLE,
) -> i32 {
    if let Some(create_fn) = CREATE_PSEUDO_CONSOLE {
        create_fn(size, h_input, h_output, flags, ph_pc)
    } else {
        -1
    }
}
static mut CONPTY_LOADED: bool = false;

fn load_conpty_api() -> Result<(), PtyErrorKind> {
    unsafe {
        if CONPTY_LOADED {
            return Ok(());
        }

        // Get kernel32 module handle by name (not NULL, which returns exe handle)
        let kernel32_name: Vec<u16> = "kernel32.dll".encode_utf16().chain(Some(0)).collect();
        let kernel32 = windows::Win32::System::LibraryLoader::GetModuleHandleW(
            windows::core::PCWSTR(kernel32_name.as_ptr()),
        )
        .map_err(|e| PtyErrorKind::OpenFailed(format!("GetModuleHandleW: {:?}", e)))?;

        // Function names in kernel32 (static to avoid lifetime issues)
        static CREATE_NAME: [u8; 20] = *b"CreatePseudoConsole\0";
        static RESIZE_NAME: [u8; 20] = *b"ResizePseudoConsole\0";
        static CLOSE_NAME: [u8; 19] = *b"ClosePseudoConsole\0";

        unsafe {
            let create_ptr = windows::Win32::System::LibraryLoader::GetProcAddress(
                kernel32,
                std::mem::transmute::<*const u8, windows::core::PCSTR>(CREATE_NAME.as_ptr()),
            );
            if create_ptr.is_none() {
                return Err(PtyErrorKind::OpenFailed(
                    "ConPTY not available on this Windows version".to_string(),
                ));
            }
            CREATE_PSEUDO_CONSOLE = Some(std::mem::transmute(create_ptr.unwrap()));

            if let Some(ptr) = windows::Win32::System::LibraryLoader::GetProcAddress(
                kernel32,
                std::mem::transmute::<*const u8, windows::core::PCSTR>(RESIZE_NAME.as_ptr()),
            ) {
                RESIZE_PSEUDO_CONSOLE = Some(std::mem::transmute(ptr));
            }
            if let Some(ptr) = windows::Win32::System::LibraryLoader::GetProcAddress(
                kernel32,
                std::mem::transmute::<*const u8, windows::core::PCSTR>(CLOSE_NAME.as_ptr()),
            ) {
                CLOSE_PSEUDO_CONSOLE = Some(std::mem::transmute(ptr));
            }
        }

        CONPTY_LOADED = true;
        Ok(())
    }
}

// ============================================================================
// Proper Windows Command Line Quoting (from portable-pty / ArgvQuote)
// ============================================================================

fn append_quoted_wide(arg: &OsStr, cmdline: &mut Vec<u16>) {
    let wide: Vec<u16> = arg.encode_wide().collect();

    if !arg.is_empty()
        && !wide.iter().any(|&c| {
            c == ' ' as u16
                || c == '\t' as u16
                || c == '\n' as u16
                || c == '\x0b' as u16
                || c == '"' as u16
        })
    {
        cmdline.extend(wide);
        return;
    }

    cmdline.push('"' as u16);

    let mut i = 0;
    while i < wide.len() {
        let mut num_backslashes = 0;
        while i < wide.len() && wide[i] == '\\' as u16 {
            i += 1;
            num_backslashes += 1;
        }

        if i == wide.len() {
            for _ in 0..num_backslashes * 2 {
                cmdline.push('\\' as u16);
            }
            break;
        } else if wide[i] == '"' as u16 {
            for _ in 0..num_backslashes * 2 + 1 {
                cmdline.push('\\' as u16);
            }
            cmdline.push('"' as u16);
            i += 1;
        } else {
            for _ in 0..num_backslashes {
                cmdline.push('\\' as u16);
            }
            cmdline.push(wide[i]);
            i += 1;
        }
    }

    cmdline.push('"' as u16);
}

// ============================================================================
// Windows ConPTY Backend
// ============================================================================

struct SendSyncHandle(HANDLE);
unsafe impl Send for SendSyncHandle {}
unsafe impl Sync for SendSyncHandle {}
impl Clone for SendSyncHandle {
    fn clone(&self) -> Self {
        SendSyncHandle(self.0)
    }
}

pub struct WinChildProcess {
    pid: u32,
    process_handle: SendSyncHandle,
    thread_handle: SendSyncHandle,
    exit_code: Arc<parking_lot::Mutex<Option<u32>>>,
}

impl Drop for WinChildProcess {
    fn drop(&mut self) {
        unsafe {
            let _ = CloseHandle(self.process_handle.0);
            let _ = CloseHandle(self.thread_handle.0);
        }
    }
}

impl ChildKiller for WinChildProcess {
    fn kill(&self) -> PtyResult<()> {
        self.do_kill()
    }

    fn clone_killer(&self) -> Box<dyn ChildKiller + Send + Sync> {
        Box::new(self.clone())
    }
}

impl Clone for WinChildProcess {
    fn clone(&self) -> Self {
        // For a production version you should duplicate handles.
        // This simple clone shares the same HANDLEs, which is unsafe if one is closed early.
        // We keep it simple for demonstration – in real code use DuplicateHandle.
        WinChildProcess {
            pid: self.pid,
            process_handle: self.process_handle.clone(),
            thread_handle: self.thread_handle.clone(),
            exit_code: self.exit_code.clone(),
        }
    }
}

#[async_trait::async_trait]
impl ChildBackend for WinChildProcess {
    fn pid(&self) -> u32 {
        self.pid
    }

    fn is_running(&self) -> bool {
        let guard = self.exit_code.try_lock();
        match guard {
            Some(guard) => guard.is_none(),
            None => true,
        }
    }

    async fn wait(&self) -> Option<ProcessExit> {
        if let Some(code) = self.is_complete() {
            return Some(ProcessExit {
                pid: self.pid,
                exit_code: Some(code as i32),
                signal: None,
            });
        }

        loop {
            {
                let guard = self.exit_code.lock();
                if let Some(code) = *guard {
                    return Some(ProcessExit {
                        pid: self.pid,
                        exit_code: Some(code as i32),
                        signal: None,
                    });
                }
            }
            tokio::time::sleep(Duration::from_millis(50)).await;
        }
    }

    fn signal(&self, sig: i32) -> Result<(), PtyErrorKind> {
        match sig {
            2 => unsafe {
                windows::Win32::System::Console::GenerateConsoleCtrlEvent(
                    windows::Win32::System::Console::CTRL_C_EVENT,
                    0,
                )
                .map_err(|e| PtyErrorKind::SignalError(format!("GenerateConsoleCtrlEvent: {:?}", e)))
            },
            9 | 15 => self.do_kill(),
            _ => Err(PtyErrorKind::SignalError(format!(
                "Signal {} not supported on Windows",
                sig
            ))),
        }
    }
}

impl WinChildProcess {
    fn is_complete(&self) -> Option<u32> {
        let mut code: u32 = 0;
        let result = unsafe { GetExitCodeProcess(self.process_handle.0, &mut code) };
        if result.is_ok() && code != 259 {
            Some(code)
        } else {
            None
        }
    }

    fn do_kill(&self) -> Result<(), PtyErrorKind> {
        unsafe {
            TerminateProcess(self.process_handle.0, 1)
                .map_err(|e| PtyErrorKind::ForkFailed(format!("TerminateProcess failed: {:?}", e)))
        }
    }
}

#[derive(Clone)]
pub struct WinPtyBackend {
    conpty_handle: SendSyncHandle,
    stdin_write: SendSyncHandle,    // Our write end for stdin (ConPTY reads from other end)
    stdin_read: SendSyncHandle,     // Read end passed to ConPTY
    stdout_read: SendSyncHandle,    // Our read end for stdout (ConPTY writes to other end)
    stdout_write: SendSyncHandle,   // Write end passed to ConPTY
    output_buffer: Arc<parking_lot::Mutex<Vec<u8>>>,
    size: Arc<parking_lot::Mutex<Winsize>>,
}

impl Drop for WinPtyBackend {
    fn drop(&mut self) {
        unsafe {
            if let Some(close_fn) = CLOSE_PSEUDO_CONSOLE {
                let _ = close_fn(self.conpty_handle.0);
            }
            // Closing the read end will cause the reader thread's ReadFile to return
            let _ = CloseHandle(self.stdout_read.0);
            let _ = CloseHandle(self.stdin_write.0);
            let _ = CloseHandle(self.stdin_read.0);
            let _ = CloseHandle(self.stdout_write.0);
        }
    }
}

#[async_trait::async_trait]
impl PtyBackend for WinPtyBackend {
    async fn read(&self, buf: &mut [u8]) -> std::io::Result<usize> {
        // Poll the output buffer populated by the background reader thread.
        let buf_len = buf.len();
        let output = self.output_buffer.clone();

        let (n, data) = tokio::task::spawn_blocking(move || {
            let mut guard = output.lock();
            if guard.is_empty() {
                return Ok::<_, std::io::Error>((0usize, Vec::new()));
            }
            let available = guard.len().min(buf_len);
            let data: Vec<u8> = guard.drain(..available).collect();
            Ok((data.len(), data))
        }).await.map_err(|e| std::io::Error::new(std::io::ErrorKind::Other, format!("spawn_blocking: {}", e)))??;

        buf[..n].copy_from_slice(&data[..n]);
        Ok(n)
    }

    async fn write(&self, buf: &[u8]) -> std::io::Result<usize> {
        let data = buf.to_vec();
        let raw_handle = self.stdin_write.0 .0 as usize;

        tokio::task::spawn_blocking(move || -> std::io::Result<usize> {
            unsafe {
                let handle = HANDLE(std::ptr::with_exposed_provenance_mut::<std::ffi::c_void>(raw_handle as _));
                let mut bytes_written: u32 = 0;
                let ok = WriteFile(handle, Some(&data), Some(&mut bytes_written), None);
                match ok {
                    Ok(()) => Ok(bytes_written as usize),
                    Err(e) => Err(std::io::Error::new(
                        std::io::ErrorKind::Other,
                        format!("WriteFile failed: {:?}", e),
                    )),
                }
            }
        }).await.map_err(|e| std::io::Error::new(std::io::ErrorKind::Other, format!("spawn_blocking: {}", e)))?
    }

    fn set_winsize(&self, winsize: Winsize) -> PtyResult<()> {
        unsafe {
            if let Some(resize_fn) = RESIZE_PSEUDO_CONSOLE {
                let hr = resize_fn(
                    self.conpty_handle.0,
                    COORD {
                        X: winsize.cols as i16,
                        Y: winsize.rows as i16,
                    },
                );
                if hr < 0 {
                    return Err(PtyErrorKind::OpenFailed(format!(
                        "ResizePseudoConsole failed: HRESULT {}",
                        hr
                    )));
                }
            }
        }
        // Update local size
        *self.size.lock() = winsize;
        Ok(())
    }

    fn get_winsize(&self) -> PtyResult<Winsize> {
        Ok(*self.size.lock())
    }

    fn raw_handle(&self) -> *mut std::ffi::c_void {
        self.conpty_handle.0.0 as *mut std::ffi::c_void
    }

    fn is_open(&self) -> bool {
        !self.conpty_handle.0.is_invalid()
    }
}

// ============================================================================
// Pipe creation for ConPTY
// ============================================================================

/// Create an anonymous pipe pair using CreatePipe.
/// Returns (read_end, write_end) as returned by CreatePipe.
///
/// For stdin: caller should use write_end to write, pass read_end to ConPTY
/// For stdout: caller should use read_end to read, pass write_end to ConPTY
///
/// Anonymous pipes don't have FILE_FLAG_OVERLAPPED, so ConPTY can do synchronous I/O.
fn create_conpty_pipe_pair() -> Result<(HANDLE, HANDLE), PtyErrorKind> {
    unsafe {
        let mut read_end: HANDLE = INVALID_HANDLE_VALUE;
        let mut write_end: HANDLE = INVALID_HANDLE_VALUE;

        // ConPTY requires inheritable pipe handles
        let sa = SECURITY_ATTRIBUTES {
            nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
            lpSecurityDescriptor: std::ptr::null_mut(),
            bInheritHandle: true.into(),
        };

        CreatePipe(
            &mut read_end,
            &mut write_end,
            Some(&sa),
            4096, // buffer size
        ).map_err(|e| PtyErrorKind::OpenFailed(format!("CreatePipe failed: {:?}", e)))?;

        Ok((read_end, write_end))
    }
}

/// Spawn a background thread that continuously reads from the stdout pipe
/// and appends data to the shared output buffer.
///
/// The thread runs in a loop calling ReadFile on the pipe. When ReadFile
/// returns 0 bytes (pipe closed) or an error, the thread exits.
/// The thread is detached and will be cleaned up when the handle is closed.
fn start_reader_thread(
    raw_handle: usize,
    output_buffer: Arc<parking_lot::Mutex<Vec<u8>>>,
) {
    thread::spawn(move || {
        let mut buf = [0u8; 4096];
        loop {
            unsafe {
                let handle = HANDLE(std::ptr::with_exposed_provenance_mut::<std::ffi::c_void>(raw_handle as _));
                let mut bytes_read: u32 = 0;
                let result = ReadFile(handle, Some(&mut buf), Some(&mut bytes_read), None);
                match result {
                    Ok(()) => {
                        let n = bytes_read as usize;
                        if n == 0 {
                            // Pipe closed
                            break;
                        }
                        let mut guard = output_buffer.lock();
                        guard.extend_from_slice(&buf[..n]);
                    }
                    Err(e) => {
                        let code = e.code().0;
                        if code == 109i32 { // ERROR_BROKEN_PIPE
                            break;
                        }
                        // For other errors, continue trying
                        std::thread::sleep(std::time::Duration::from_millis(10));
                    }
                }
            }
        }
    });
}

